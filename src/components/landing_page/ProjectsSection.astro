---
import { getCollection } from "astro:content";

import ProjectCard from "@components/content/projects/ProjectCard.astro";
import LandingPageSecion from "@layouts/LandingPageSecion.astro";

const projects = await getCollection("projects");
projects.sort(
  (a, b) => (b.data.favourite ? 1 : 0) - (a.data.favourite ? 1 : 0),
);
const previewProjects = projects.slice(0, 3);
---

<LandingPageSecion
  id="projects"
  title="Projects"
  titleTransitionName="project-heading"
  seeMoreHref="/projects"
  backgroundColor="var(--surface-color)"
  noDefaultPadding
>
  <div id="projects-row" data-fade>
    {previewProjects.map((project) => <ProjectCard project={project} />)}
  </div>
</LandingPageSecion>

<style>
  :global(#projects h2) {
    padding-inline: var(--horizontal-page-padding);
  }
  
  #projects-row {
    flex: 1;
    max-height: var(--project-row-height);
    margin-bottom: 2rem;
    width: 100%;
    max-width: var(--card-grid-max-width);
    align-self: center;

    display: flex;
    justify-content: center;
    overflow-x: scroll;
    gap: var(--project-card-spacing);

    scroll-snap-type: x mandatory;

    overflow-y: visible;
  }

  #projects-row > :global(*) {
    flex: 1;
    max-width: var(--project-card-width);

    scroll-snap-align: start;

    background-color: white;
    border: 1.5px solid var(--dark-accent-color);
  }

  @media (max-width: 768px) {
    #projects-row {
      justify-content: flex-start;
    }

    #projects-row > :global(*) {
      flex: 0 0 auto;
      scroll-snap-align: center;
    }

    #projects-row > :global(:first-child) {
      margin-left: var(--horizontal-page-padding);
    }

    #projects-row > :global(:last-child) {
      margin-right: var(--horizontal-page-padding);
    }
  }
</style>
