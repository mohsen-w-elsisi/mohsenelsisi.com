---
import JournalCardGrid from "@components/content/journal/JournalCardGrid.astro";
import { getCollection } from "astro:content";
import LandingPageSecion from "@layouts/LandingPageSecion.astro";

const journals = (await getCollection("journalMetadata")).toSorted((a, b) => {
  const aFav = a.data.favourite ? 1 : 0;
  const bFav = b.data.favourite ? 1 : 0;
  return bFav - aFav;
});
---

<LandingPageSecion
  id="journals"
  title="Journals"
  titleTransitionName="journal-heading"
  backgroundColor="var(--light-accent-color)"
  cardBackgroundColor="var(--surface-color)"
  seeMoreHref="/journals"
>
  <p>
    Read My day-to-day experiences abd thoughts working on projects or learning
    new things.
  </p>
  <JournalCardGrid journals={journals} />
</LandingPageSecion>
