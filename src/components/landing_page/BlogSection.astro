---
import { getCollection } from "astro:content";

import LandingPageSection from "@layouts/LandingPageSecion.astro";
import BlogCardGrid from "../content/blog/BlogCardGrid.astro";

const posts = await getCollection("posts");
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const recentPosts = posts.slice(0, 4);
---

<LandingPageSection
  id="blog"
  title="Blog"
  titleTransitionName="blog-heading"
  backgroundColor="var(--dark-color)"
  textColor="var(--surface-color)"
  cardBackgroundColor="var(--dark-accent-color)"
  cardTextColor="var(--surface-color)"
  seeMoreHref="/blog"
>
  <BlogCardGrid posts={recentPosts} />
</LandingPageSection>
