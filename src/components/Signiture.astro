---
import SignitureSVG from "@assets/signature.svg";
---

<span id="signature">
  <SignitureSVG />
</span>

<script>
  let signature: SVGElement;
  let signaturePaths: NodeListOf<SVGPathElement>;

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) animateSignature();
  });

  const animateSignature = () => {
    signaturePaths.forEach((path) => {
      path.classList.add("draw");
    });
  };

  const setupSignatureAnimation = () => {
    if (signature) observer.unobserve(signature); // clean up
    
    signature = document.querySelector("#signature svg")!;
    signaturePaths = signature.querySelectorAll("path");

    let pathIndex = 0;
    let accumulatedLength = 0;
    for (const path of signaturePaths) {
      const pathLength = path.getTotalLength();
      path.style.setProperty("--path-length", pathLength.toString());
      path.style.setProperty("--path-index", pathIndex.toString());
      path.style.setProperty("--accum-length", accumulatedLength.toString());
      pathIndex++;
      accumulatedLength += pathLength;
    }

    observer.observe(signature);
  };

  document.addEventListener("astro:page-load", setupSignatureAnimation);
</script>

<style>
  span :global(svg) {
    stroke: var(--surface-color);
    height: 4rem;
    width: auto;

    path {
      stroke-dasharray: var(--path-length);
      stroke-dashoffset: var(--path-length);

      --draw-rate: 0.005s; /* per pixel */

      transition-property: stroke-dashoffset;
      transition-duration: calc(var(--path-length, 0) * var(--draw-rate));
      transition-delay: calc(var(--accum-length, 0) * var(--draw-rate));

      &.draw {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
