---
interface Props {
  id: string;
  title: string;
  titleTransitionName?: string;
  backgroundColor?: string;
  textColor?: string;
  cardBackgroundColor?: string;
  cardTextColor?: string;
  seeMoreHref?: string;
  defaultLayout?: boolean;
  noDefaultLayout?: boolean;
  noDefaultPadding?: boolean;
  fullHeight?: boolean;
}

const {
  id,
  title,
  titleTransitionName,
  backgroundColor,
  textColor,
  cardBackgroundColor,
  cardTextColor,
  seeMoreHref,
  fullHeight = false,
  defaultLayout = true,
  noDefaultLayout = false,
  noDefaultPadding = false,
} = Astro.props as Props;
---

<section
  id={id}
  class:list={{ fullHeight, defaultLayout, noDefaultLayout, noDefaultPadding }}
>
  <h2 data-fade transition:name={titleTransitionName}>
    {title}
  </h2>
  <slot />

  {
    seeMoreHref && (
      <a class="see-more" data-fade href={seeMoreHref}>
        See More
      </a>
    )
  }
</section>

<style
  define:vars={{
    backgroundColor,
    textColor,
    cardBackgroundColor,
    cardTextColor,
  }}
>
  section {
    background-color: var(--backgroundColor);
    color: var(--textColor);

    &.fullHeight {
      min-height: 100vh;
    }
    &:not(.noDefaultPadding) {
      padding-inline: var(--landing-page-section-x-pad);
    }
    &:not(.noDefaultLayout) {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding-bottom: 2rem;
    }
  }

  section :global(.card) {
    background-color: var(--cardBackgroundColor);
    color: var(--cardTextColor);
  }

  .see-more {
    margin-right: auto;
    margin-left: auto;
    font-size: var(--display-body-font-size);
  }
</style>
